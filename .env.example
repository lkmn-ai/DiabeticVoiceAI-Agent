# ============================================================
# OrthoVoice AI - Environment Configuration
# Copy to backend/.env  (or project root .env)
# ============================================================

# ─── Groq LLM (required for personalized / low-RAG queries) ─
GROQ_API_KEY=addhere
# GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq

# Optional local fallback (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# ─── Whisper STT ────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ─── Embedding Model ────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── RAG / Cache Thresholds ─────────────────────────────────
TOP_K=5
RAG_THRESHOLD=0.75
CACHE_THRESHOLD=0.90

# ─── Backend Server ─────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── Storage Paths ──────────────────────────────────────────
CHROMA_PERSIST_DIR=../storage/chroma
CACHE_PERSIST_DIR=../storage/cache

# ─── TTS (Piper) ────────────────────────────────────────────
PIPER_BINARY=piper
PIPER_MODEL_PATH=../models/en_US-lessac-medium.onnx
TTS_OUTPUT_DIR=../storage/tts

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
